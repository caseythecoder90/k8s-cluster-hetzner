# Example inventory. The REAL hosts.yml is generated by `terraform apply`
# (see terraform/outputs.tf) and is gitignored because it contains live IPs.
all:
  vars:
    ansible_user: deploy
    ansible_ssh_private_key_file: ~/.ssh/hetzner_k8s
  children:
    control_plane:
      hosts:
        prod-cp-1:
          ansible_host: 203.0.113.10   # public IP from terraform output
          private_ip: 10.0.1.10
    workers:
      hosts:
        prod-worker-1:
          ansible_host: 203.0.113.20
          private_ip: 10.0.1.20
