# --- Terraform ---
# State contains server IPs, resource IDs, and potentially secrets. Never commit.
*.tfstate
*.tfstate.*
.terraform/
# (.terraform.lock.hcl IS committed on purpose — it pins provider versions)
crash.log

# Real variable values (API token lives in env var, but keep tfvars out anyway)
terraform.tfvars
*.auto.tfvars

# --- Ansible ---
# Generated by Terraform (local_file) — contains live IPs. Regenerate anytime.
ansible/inventory/hosts.yml
*.retry

# Fetched cluster credentials — full admin access, never commit
ansible/kubeconfig/

# --- Practice lab ---
practice/ansible/inventory/hosts.yml
practice/ansible/kubeconfig/
# killer.sh questions are copyrighted — scenarios stay local-only, never pushed
practice/scenarios/

# --- Database dumps (real user data, never commit) ---
*.dump

# --- Secrets, always ---
*.pem
*.key
!*.pub
secrets/
.env

# --- Editor/OS noise ---
.vscode/
.idea/
Thumbs.db
.DS_Store
